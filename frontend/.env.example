# frontend/.env — local overrides (optional)
#
# Contract addresses and secrets live in the ROOT .env (one level up).
# Do NOT set OBSERVER_ADDRESS or OBSERVER_FUND_ADDRESS here —
# they are loaded from the root .env as the single source of truth.
#
# The only things that belong here are frontend-only dev overrides:

# Optional — override Observer API base URL (default: staging API)
# Set to http://localhost:3001 to use the local mock server
# API_BASE=http://localhost:3001
