# frontend/.env — optional, overrides values from the project root .env
#
# OBSERVER_ADDRESS can be set here OR in the root .env (one level up).
# Root .env is loaded first; this file takes precedence if both are set.
#
# Observer.sol / ObserverTest.sol address on Sepolia:
# OBSERVER_ADDRESS=0x84E0439Da40a543E45847841393d71A45A715537

# Optional — override Capitare API base URL (default: staging API)
# Set to http://localhost:3001 to use the local mock server
# CAPITARE_BASE=http://localhost:3001
