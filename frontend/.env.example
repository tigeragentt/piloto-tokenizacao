# Observer.sol (or ObserverTest.sol) deployed address on Sepolia
# Required — set this to enable all Observer features in the frontend
# ObserverTest (Remix, already deployed): 0x84E0439Da40a543E45847841393d71A45A715537
OBSERVER_ADDRESS=

# Optional — override the Capitare API base URL (default: staging)
# Set to http://localhost:3001 to use the local mock server instead
# CAPITARE_BASE=http://localhost:3001
