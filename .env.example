# CRE wallet private key (64 hex chars, no 0x prefix)
# This account needs Sepolia ETH to send transactions to Observer.sol
CRE_ETH_PRIVATE_KEY=YOUR_64_CHARACTER_PRIVATE_KEY_HERE

# Capitare Observer API key — passed as X-Observer-Key header
# Mapped in secrets.yaml → capitare_observer_key
API_OBSERVER_KEY=YOUR_API_OBSERVER_KEY_HERE

# CRE transaction signing key (64 hex chars, no 0x prefix)
# The wallet that holds REPORTER_ROLE on Observer.sol
# Mapped in secrets.yaml → cre_transaction_private_key
CRE_TRANSACTION_PRIVATE_KEY=YOUR_64_CHARACTER_PRIVATE_KEY_HERE

# Observer.sol (or ObserverTest.sol) deployed address on Sepolia
# Used by both the frontend (VITE_*) and the CRE workflow configs
OBSERVER_ADDRESS=0x84E0439Da40a543E45847841393d71A45A715537
